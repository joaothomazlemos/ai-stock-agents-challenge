                <mxCell id="r-leg4" value="Decision / Routing" style="fontColor=#333333;rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=center;" parent="1" vertex="1">
                    <mxGeometry x="1280" y="820" width="180" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="r-chars" value="&lt;b&gt;Characteristics&lt;/b&gt;&lt;hr&gt;• Pattern: ReAct (Reason + Act)&lt;br&gt;• Graph: StateGraph(MessagesState)&lt;br&gt;• Nodes: llm_call, tool_node&lt;br&gt;• Routing: conditional_edges&lt;br&gt;• Loop: tool_node → llm_call&lt;br&gt;• Memory: AgentCoreMemorySaver (persistent)&lt;br&gt;• LLM: Claude Sonnet via Bedrock&lt;br&gt;• Streaming: .astream(updates)" style="fontColor=#333333;shape=note;html=1;fillColor=#ffffcc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=10;size=14;" parent="1" vertex="1">
                    <mxGeometry x="180" y="420" width="260" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="r-code" value="&lt;b&gt;Graph Definition&lt;/b&gt;&lt;hr&gt;checkpointer = AgentCoreMemorySaver(&lt;br&gt;&amp;nbsp;&amp;nbsp;memory_id=AGENTCORE_MEMORY_ID)&lt;br&gt;&lt;br&gt;agent = StateGraph(MessagesState)&lt;br&gt;agent.add_node(&amp;quot;llm_call&amp;quot;, llm_call)&lt;br&gt;agent.add_node(&amp;quot;tool_node&amp;quot;, tool_node)&lt;br&gt;agent.add_edge(START, &amp;quot;llm_call&amp;quot;)&lt;br&gt;agent.add_conditional_edges(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;llm_call&amp;quot;, should_continue,&lt;br&gt;&amp;nbsp;&amp;nbsp;[&amp;quot;tool_node&amp;quot;, END])&lt;br&gt;agent.add_edge(&amp;quot;tool_node&amp;quot;, &amp;quot;llm_call&amp;quot;)&lt;br&gt;agent.compile(checkpointer=checkpointer)" style="fontColor=#333333;shape=note;html=1;fillColor=#ffffcc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=9;size=14;" parent="1" vertex="1">
                    <mxGeometry x="180" y="595" width="260" height="175" as="geometry"/>
                </mxCell>
            </root>
