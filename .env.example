# AWS
AWS_REGION=us-east-1

# Bedrock LLM
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514

# Bedrock Embeddings
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMS=512

# AgentCore Memory (empty = in-memory MemorySaver for local dev)
AGENTCORE_MEMORY_ID=

# Langfuse (empty = tracing disabled)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# FAISS
FAISS_INDEX_PATH=data/faiss_index

# Server
HOST=0.0.0.0
PORT=8080

# Agent
AGENT_ACTOR_ID=ai-stock-agent
