# AWS credentials — boto3 uses these to authenticate SDK calls
# Option A: Named profile (from ~/.aws/config or ~/.aws/credentials)
AWS_PROFILE=your-profile-name
# Option B: Static keys (uncomment and fill if not using a profile)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...  # only if using temporary credentials

# Extra PATH dirs for the Jupyter kernel (e.g. where granted, aws-cli live).
# The notebook prepends this to the kernel's PATH so credential_process tools work.
# Adjust to match your OS:
#   macOS (Apple Silicon): /opt/homebrew/bin:/usr/local/bin
#   macOS (Intel):         /usr/local/bin
#   Linux:                 /usr/local/bin:/home/<user>/.local/bin
# Tip: run `which granted` or `which aws` in your terminal to find the right path.
PATH=/opt/homebrew/bin:/usr/local/bin

# AgentCore Runtime (from: terraform -chdir=terraform output -raw runtime_endpoint_arn)
RUNTIME_ENDPOINT_ARN=arn:aws:bedrock-agentcore:us-east-1:ACCOUNT_ID:runtime/RUNTIME_ID/runtime-endpoint/ENDPOINT_ID
AWS_REGION=us-east-1

# Cognito (from: terraform -chdir=terraform output)
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_USERNAME=testuser@example.com
COGNITO_PASSWORD=securePass1

# Langfuse (optional — uncomment to enable trace retrieval in the notebook)
# LANGFUSE_PUBLIC_KEY=pk-...
# LANGFUSE_SECRET_KEY=sk-...
# LANGFUSE_HOST=https://cloud.langfuse.com
